# Clés API (à ne pas commiter en prod)
# Copier vers .env ou .env.local et remplir avec vos clés réelles.

# Google Maps (iOS)
# EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=votre_cle_ios

# Google Maps (Android)
# EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=votre_cle_android

# Pour utiliser dans app.json / app.config.js, référencer process.env.EXPO_PUBLIC_*
