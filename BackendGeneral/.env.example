# ============================================================
# Taka-Taka Voyage — Backend — Variables d'environnement
#
# Copier ce fichier en ".env" (à la racine de BackendGeneral/) et
# renseigner les vraies valeurs. Le fichier ".env" ne doit JAMAIS
# être commité (voir .gitignore) : il contient des secrets réels.
# ============================================================

# --- Serveur ---
PORT=5000
NODE_ENV=development

# --- Base de données (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?appName=<app>

# --- Authentification (JWT) ---
# Ne jamais utiliser une valeur faible ou devinable en production.
# Générer une valeur forte, par exemple : openssl rand -hex 32
JWT_SECRET=

# --- CORS (origine autorisée pour le frontend) ---
FRONTEND_ORIGIN=http://localhost:3000

# --- OAuth Google (optionnel — connexion sociale) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optionnel : si absent, retombe sur /api/auth/google/callback (src/config/passport.js)
GOOGLE_CALLBACK_URL=

# --- OAuth Facebook (optionnel — connexion sociale) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optionnel : si absent, retombe sur /api/auth/facebook/callback (src/config/passport.js)
FACEBOOK_CALLBACK_URL=

# --- Cloudinary (stockage des médias uploadés) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Envoi d'e-mails (SMTP, src/utils/sendEmail.js) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# --- Brevo (e-mails transactionnels / OTP, src/services/emailService.js) ---
BREVO_API_KEY=
OTP_SENDER_EMAIL=
OTP_SENDER_NAME=Taka Taka

# --- OTP (code de vérification, src/services/OtpService.js) ---
OTP_TTL_MINUTES=5
OTP_COOLDOWN_SECONDS=60

# --- Africa's Talking (SMS, src/services/smsService.js) ---
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# --- Gemini (assistant IA, src/controllers/aiController.js) ---
GEMINI_API_KEY=

# --- Lengo Pay (paiement mobile money) ---
# Présent en config mais PAS ENCORE consommé par le code backend (aucun
# require ni process.env.LENGOPAY_* trouvé dans src/) — intégration à venir.
LENGOPAY_LICENSE_KEY=
LENGOPAY_WEBSITE_ID=
LENGOPAY_BASE_URL=https://sandbox.lengopay.com/api/v1
LENGOPAY_BASE_URL_V2=https://sandbox.lengopay.com/api/v2
LENGOPAY_CALLBACK_URL=http://localhost:5000/api/wallet/webhook/lengopay
LENGOPAY_RETURN_URL=http://localhost:3000/wallet
