# ============================================================
# Taka-Taka Voyage — Mobile (Expo) — Variables d'environnement
#
# Copier ce fichier en ".env" (à la racine de TakaTakaApp/) et
# renseigner la vraie valeur. Ne jamais commiter ".env".
# Lu par app.config.js (native config Android/iOS).
# ============================================================

# Clé Google Maps (restreinte par package name Android
# "com.takataka.voyage" / bundle ID iOS côté Google Cloud Console)
GOOGLE_MAPS_API_KEY=
