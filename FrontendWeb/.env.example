# ============================================================
# Taka-Taka Voyage — Frontend Web — Variables d'environnement
#
# Ce projet utilise Vite : seules les variables préfixées "VITE_"
# sont exposées au code client (import.meta.env.VITE_*). Toute
# autre variable (ex: préfixe "REACT_APP_", hérité d'un ancien
# projet Create React App) n'est PAS lue par le build Vite.
#
# IMPORTANT : un frontend est du code public — tout ce qui est mis
# ici finit en clair dans le JS livré au navigateur. Ne JAMAIS y
# mettre de secret serveur (clé API backend, clé de paiement, JWT
# secret, etc.). Ces valeurs n'ont leur place que dans
# BackendGeneral/.env, jamais ici.
# ============================================================

# --- API backend (src/utils/urlHelper.js, src/services/apiClient.js) ---
VITE_API_URL=http://localhost:5000/api
VITE_API_TIMEOUT=15000

# --- Socket.IO (src/services/socketService.js) ---
VITE_SOCKET_URL=http://localhost:5000
